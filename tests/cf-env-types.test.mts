/**
 * The normalizer behind `cloudflare-env.d.ts` (#387).
 *
 * The committed file is committed *and* rewritten by wrangler, which means the
 * only thing standing between `wrangler.toml` and the file that typechecks the
 * Worker is this one pure function. Its failure modes are invisible in review:
 * a normalization that deletes too much produces a file that still compiles and
 * still says what the bindings are, minus one, and nothing goes red.
 *
 * The regression these exist for is that. The first version stripped
 * `Cloudflare.GlobalProps` with `(?:\t.*\n)*`, a group that matches any
 * single-tab-indented line -- so it did not stop at GlobalProps' own closing
 * brace, it ran on through every sibling interface in the namespace and stopped
 * at the namespace's. It deleted `Cloudflare.StagingEnv` along with it and the
 * gate reported green, because the gate diffs normalize(raw) against the
 * committed file and both sides had lost the same declaration. Nothing in the
 * repo referenced `StagingEnv`, so no typecheck noticed either.
 *
 * Driven through the exported function, not through the script, so these do not
 * shell out to wrangler or touch the committed file.
 */

import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";
import test from "node:test";
import { normalize } from "../scripts/cf-env-types.mjs";

const root = path.join(import.meta.dirname, "..");
const COMMITTED = path.join(root, "cloudflare-env.d.ts");

/** Wrangler's real shape, trimmed to the part normalize() has an opinion about. */
const RAW = [
  "/* eslint-disable */",
  "// Generated by Wrangler by running `wrangler types ...` (hash: deadbeef)",
  "interface __BaseEnv_CloudflareEnv {",
  "\tWEB: R2Bucket;",
  "\tNEXT_PUBLIC_SITE_URL: \"https://nessebarlens.com\";",
  "}",
  "declare namespace Cloudflare {",
  "\tinterface GlobalProps {",
  "\t\tmainModule: typeof import(\"./worker\");",
  "\t}",
  "\tinterface StagingEnv {",
  "\t\tWEB: R2Bucket;",
  "\t}",
  "\tinterface Env extends __BaseEnv_CloudflareEnv {}",
  "}",
  "interface CloudflareEnv extends __BaseEnv_CloudflareEnv {}",
  "type StringifyValues<EnvType extends Record<string, unknown>> = {",
  "\t[Binding in keyof EnvType]: EnvType[Binding] extends string ? EnvType[Binding] : string;",
  "};",
  "declare namespace NodeJS {",
  '\tinterface ProcessEnv extends StringifyValues<Pick<Cloudflare.Env, "NEXT_PUBLIC_SITE_URL">> {}',
  "}",
].join("\n");

test("the strip takes GlobalProps and nothing after it", () => {
  const out = generatedBody(normalize(RAW));
  assert.ok(!out.includes("GlobalProps"), "GlobalProps must be gone");
  assert.ok(!out.includes("mainModule"), "mainModule drags worker.ts into the program");
  // The regression. StagingEnv is a sibling, not part of GlobalProps.
  assert.match(out, /interface StagingEnv \{/u);
  assert.match(out, /interface Env extends __BaseEnv_CloudflareEnv \{\}/u);
  assert.match(out, /^interface CloudflareEnv extends __BaseEnv_CloudflareEnv \{\}/mu);
});

test("the NodeJS.ProcessEnv augmentation is dropped whole", () => {
  // #401. The augmentation makes NEXT_PUBLIC_SITE_URL *required* in
  // `process.env` and narrows it to two literal hosts, which is a Worker fact
  // leaking into a Node global. It rejects `delete process.env.X` (TS2790) and
  // any other string (TS2322) — sixteen sites in the suite, currently quiet
  // only because `process` is `any`.
  const out = generatedBody(normalize(RAW));
  assert.ok(!out.includes("ProcessEnv"), "the ProcessEnv augmentation must be gone");
  assert.ok(!out.includes("declare namespace NodeJS"), "not left as an empty namespace");
  // Wrangler's own output, kept deliberately: stripping it would be a third
  // pattern to keep in step, and the next wrangler to use it would break.
  assert.match(out, /type StringifyValues</u);
});

test("a ProcessEnv the strip cannot match throws instead of committing", () => {
  // Re-indented by one tab, which is what wrangler changing its own emitter
  // would look like. Committing this would put a Worker var in the Node global
  // under a header that promises it was not.
  assert.throws(
    () => normalize(RAW.replace(/\tinterface ProcessEnv/u, "   interface ProcessEnv")),
    /interface ProcessEnv` survived/u,
  );
});

test("the reference is added exactly once", () => {
  const once = normalize(RAW);
  assert.equal(once.match(/@cloudflare\/workers-types/gu)?.length, 1);
  // Idempotence: the gate normalizes a file that already went through here once.
  assert.equal(normalize(once), once);
});

test("the committed file ends in a newline", () => {
  // Wrangler writes none, and git reports the whole file as changed when the
  // last line differs only by its terminator. Exactly one: the last declaration
  // is whatever survived the strips, so asserting on which brace it is would be
  // asserting on the normalisations rather than on this.
  const out = normalize(RAW);
  assert.ok(out.endsWith("\n"), "no trailing newline");
  assert.ok(!out.endsWith("\n\n"), "no blank line at the end");
});

test("a GlobalProps declaration the strip cannot match throws instead of committing", () => {
  // The other direction: silent over-stripping is bad, but a silent
  // under-stripping reintroduces the TS2307 x2 that made the full file fail
  // `tsc`. Refuse to write and say why. Re-indented by one tab, which is what
  // wrangler changing its own emitter would look like.
  assert.throws(
    () => normalize(RAW.replace(/\t\tmainModule/u, "   mainModule")),
    /survived the strip/u,
  );
});

test("output that never mentions GlobalProps is left alone", () => {
  // The complement: wrangler dropping the block is not a reason to refuse. The
  // first version of the guard keyed on the word, so it threw here too.
  assert.doesNotThrow(() => normalize(RAW.replace(/\tinterface GlobalProps \{[\s\S]*?\t\}\n/u, "")));
});

/** The part wrangler wrote: everything from its own generated-by line on. */
function generatedBody(file: string): string {
  return file.slice(file.indexOf("// Generated by Wrangler by running"));
}

test("the committed file carries the reference and not the worker import", () => {
  const committed = fs.readFileSync(COMMITTED, "utf8");
  assert.match(committed, /^\/\/\/ <reference types="@cloudflare\/workers-types" \/>/u);
  // `.open-next/worker.js` is a build artifact and worker.ts is in tsconfig's
  // exclude list; a `typeof import()` of either is TS2307 on a fresh clone.
  // Scoped to what wrangler wrote -- this file's own header says the words.
  const body = generatedBody(committed);
  assert.ok(!/\bimport\(/u.test(body), "no dynamic import may reach worker.ts");
  assert.ok(!body.includes(".open-next"), "no build-artifact path in a committed type");
  // #401, on the committed file rather than the fixture: this is the one that
  // is read by every program in the repo.
  assert.ok(!body.includes("ProcessEnv"), "no Worker var described as a Node one");
});

test("the committed file still declares the env wrangler.toml configures", () => {
  // The witness the gate cannot be. An over-strip takes the declaration out of
  // both sides of the diff and the gate reports green; nothing else in the repo
  // names `Cloudflare.StagingEnv`, so no typecheck notices either. Spelled for
  // the env this repo has -- the general guard is the RAW fixture above, which
  // does not have to guess how wrangler names a section.
  const toml = fs.readFileSync(path.join(root, "wrangler.toml"), "utf8");
  const committed = generatedBody(fs.readFileSync(COMMITTED, "utf8"));
  if (/^\[env\.staging\]$/mu.test(toml)) {
    assert.match(committed, /interface StagingEnv \{/u);
  }
  assert.match(committed, /interface Env extends __BaseEnv_CloudflareEnv \{\}/u);
});